{
    "name": "wattyrev/api.kitepaint",
    "description": "KitePaint PHP API",
    "type": "project",
    "license": "ISC",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
